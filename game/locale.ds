-- locale.ds — все строки игры на двух языках (порт старого locale.ds).
-- Строки онлайна (вход, чат, бан, реконнект) удалены вместе с онлайном;
-- вместо них — пара строк для плашки «Недоступно».

tr_play(): string {
    if language == 1 then
        return "Играть"
    }
    return "Play"
}

