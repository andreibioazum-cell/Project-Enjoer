-- Предупреждение об эпилепсии — оба языка сразу, язык настроек не важен.
-- Вторая строка говорит о вспышках эффектов в бою (диско-режим жил в онлайне,
-- которого в порте нет).
tr_warn_title_en(): string {
    return "WARNING"
}

tr_warn_title_ru(): string {
    return "ВНИМАНИЕ"
}

tr_warn_en1(): string {
    return "This game contains bright flashes"
}

tr_warn_en2(): string {
    return "and flashing effects in battle."
}

tr_warn_en3(): string {
    return "If you have epilepsy or are sensitive"
}

tr_warn_en4(): string {
    return "to light, please play with caution."
}

tr_warn_ru1(): string {
    return "В игре есть яркие вспышки и эффекты"
}

tr_warn_ru2(): string {
    return "в бою."
}

tr_warn_ru3(): string {
    return "При эпилепсии или чувствительности"
}

tr_warn_ru4(): string {
    return "к свету играйте осторожно."
}

