<?xml version="1.0" encoding="utf-8"?>
<!--
  package — уникальный идентификатор приложения в RuStore. Сменить его после
  публикации нельзя. Формат — обратный домен минимум из трёх сегментов:
  короткое имя вроде «com.cb4» легко пересекается с чужим пакетом в каталоге,
  и тогда версия не проходит обработку загрузки. Ключ подписи и versionCode —
  в .github/workflows/main.yml.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.enjoer.game"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="Enjoer"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

        <activity
            android:name="ru.enjoer.game.GameActivity"
            android:label="Enjoer"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:exported="true">
            <meta-data android:name="android.app.lib_name" android:value="ds_game" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
