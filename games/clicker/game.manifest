-- Enjoer game manifest: Кликер, the game that ships on the device.
--
-- The logic below lives in main.ds; this is also the single source the
-- checked-in src/generated/clicker.c is regenerated from, so the APK, the
-- preview and `dimscriptc --run` all execute the same game.

title = "Кликер"
author = "Enjoer"
package = "com.cb4.clicker"
version = "1.0"
version_code = 1

-- portrait | landscape | sensor
orientation = "sensorLandscape"
target_fps = 60
resizeable = true

-- Background colour before the first script frame, as r g b in 0..1.
clear_color = 0.05 0.08 0.15

-- Load order for the .ds files.  Anything not listed is still loaded, after
-- these, so forgetting a file only changes startup order.
scripts = ["main.ds"]

-- DejaVu Sans Bold (free license, see README.md): the bundled UI face.
fonts = ["font.ttf"]
