-- Кликер — the Enjoer clicker game, with a real bundled font.
--
-- load() reads font.ttf (DejaVu Sans Bold) through font.load and draw()
-- selects it with render.font, so every render.text becomes tinted glyph
-- quads on the device — the same pixels the preview shows.  Scale 1.0 is a
-- 16 px em, so body text sits at 2.0 and up.
--
-- This file is the single source of the game: src/generated/clicker.c is
-- regenerated from this folder, and the APK, the preview and
-- `dimscriptc --run` all execute it.

struct ClickerGame {
    score: int
    best: int
    text_scale: float -- scale used for the click animation
    font: int -- handle from font.load, -1 when the font is missing
}

game = new ClickerGame

load() {
    game.score = 0
    game.best = 0
    game.text_scale = 1.0 -- base scale
    game.font = font.load("font.ttf")
}

tap() {
    game.score = game.score + 1
    if game.score > game.best then {
        game.best = game.score
    }
    game.text_scale = 1.6
}

touchpressed(id, touch_x, touch_y) {
    tap()
}

keypressed(name: string) {
    if name == "space" then {
        tap()
    }
}

update(dt: float) {
    -- Smoothly return the scale to 1.0 every second.
    if game.text_scale > 1.0 then {
        game.text_scale = game.text_scale - (4.0 * dt)
        if game.text_scale < 1.0 then {
            game.text_scale = 1.0
        }
    }
}

draw() {
    render.clear(0.05, 0.08, 0.15)
    render.font(game.font)
    render.color(1.0, 1.0, 1.0)

    -- The marquee is big on purpose: phones want 2.0 and up.
    render.text("Главное меню", 20.0, 20.0, 2.0)

    -- The score uses the animated scale.
    render.text("Счет: " .. game.score, 50.0, 150.0, game.text_scale * 2.0)

    render.color(0.75, 0.85, 1.0)
    render.text("Тапни по экрану, чтобы заработать", 50.0, 300.0, 1.5)
    render.text("Рекорд: " .. game.best, 50.0, 340.0, 1.5)
}

quit() {
    delete game
}
