-- Кирпич: brick layout and ball physics.
--
-- Structs declared here are visible to every file of the game: the linker
-- registers all declarations before it resolves bodies, so main.ds can keep a
-- `list` of bricks while blocks.ds knows what a brick looks like.

struct Brick {
    x: float
    y: float
    width: float
    height: float
    shade: float
    alive: bool
}

build_blocks(columns: int): list {
    local u = ui()
    blocks = []
    margin = 18.0 * u
    top = 86.0 * u -- below the HUD band hud.ds lays out with the same u
    row_height = 22.0 * u
    gap = 6.0 * u
    rows = 5
    cell = (engine.width() - margin * 2.0) / columns
    for row = 0, rows do
        for column = 0, columns - 1 do
            brick = new Brick
            brick.x = margin + cell * column + gap / 2.0
            brick.y = top + row * (row_height + gap)
            brick.width = cell - gap
            brick.height = row_height
            brick.shade = 0.10 + 0.16 * (rows - row)
            brick.alive = true
            blocks.push(brick)
        }
    }
    return blocks
}

launch_ball() {
    -- Speeds scale with the field, or the same game is a slow-motion replay on
    -- a phone and a blur on a small preview.
    local u = ui()
    game.ball.vx = 165.0 * u
    game.ball.vy = -330.0 * u
    game.ball.stuck = true
}

step_ball(g: BrickGame, dt: float) {
    if g.ball.stuck then {
        return
    }
    radius = g.ball.radius
    g.ball.x = g.ball.x + g.ball.vx * dt
    g.ball.y = g.ball.y + g.ball.vy * dt

    if g.ball.x < radius then {
        g.ball.x = radius
        g.ball.vx = -g.ball.vx
    }
    if g.ball.x > engine.width() - radius then {
        g.ball.x = engine.width() - radius
        g.ball.vx = -g.ball.vx
    }
    if g.ball.y < radius + 12.0 * ui() then {
        g.ball.y = radius + 12.0 * ui()
        g.ball.vy = -g.ball.vy
    }
    bounce_off_paddle(g)
    hit_bricks(g)
}

bounce_off_paddle(g: BrickGame) {
    half = g.paddle.width / 2.0
    left = g.paddle.x - half
    right = g.paddle.x + half
    top = g.paddle.y
    radius = g.ball.radius
    below = g.ball.y + radius >= top
    above = g.ball.y - radius <= top + g.paddle.height
    inside = g.ball.x >= left - radius and g.ball.x <= right + radius
    if g.ball.vy > 0.0 and below and above and inside then {
        g.ball.y = top - radius
        offset = (g.ball.x - g.paddle.x) / half
        local u = ui()
        speed = math.sqrt(g.ball.vx * g.ball.vx + g.ball.vy * g.ball.vy)
        if speed < 240.0 * u then {
            speed = 240.0 * u
        }
        if speed > 520.0 * u then {
            speed = 520.0 * u
        }
        g.ball.vx = speed * offset * 0.72
        g.ball.vy = -speed
    }
}

hit_bricks(g: BrickGame) {
    for index = 0, g.blocks.count - 1 do
        brick = g.blocks[index]
        if brick.alive then {
            if overlaps(g.ball, brick) then {
                brick.alive = false
                g.score = g.score + 1
                from_top = g.ball.y + g.ball.radius - brick.y
                from_bottom = brick.y + brick.height - (g.ball.y - g.ball.radius)
                if from_top < from_bottom then {
                    g.ball.y = brick.y - g.ball.radius
                    g.ball.vy = -math.abs(g.ball.vy)
                } else {
                    g.ball.y = brick.y + brick.height + g.ball.radius
                    g.ball.vy = math.abs(g.ball.vy)
                }
                if g.score >= g.blocks.count then {
                    g.state = 3
                }
                return
            }
        }
    }
}

overlaps(ball: Ball, brick: Brick): bool {
    near_x = math.max(brick.x, math.min(ball.x, brick.x + brick.width))
    near_y = math.max(brick.y, math.min(ball.y, brick.y + brick.height))
    dx = ball.x - near_x
    dy = ball.y - near_y
    return dx * dx + dy * dy <= ball.radius * ball.radius
}
