-- Enjoer game manifest.
--
-- A manifest is a flat `key = value` file, one setting per line, with `--`
-- comments.  It is read by the engine at startup (games/brick) and by
-- tools/gamepack.py when the APK is assembled, so the AndroidManifest.xml is
-- generated from the same data.
--
-- Icons are deliberately not part of the format yet: an `icon` key is rejected
-- with a clear error instead of being silently ignored.

title = "Кирпич"
author = "Enjoer"
package = "com.cb4.brick"
version = "1.0"
version_code = 2

-- portrait | landscape | sensor
orientation = "sensorLandscape"
target_fps = 60
resizeable = true

-- Background colour before the first script frame, as r g b in 0..1.
clear_color = 0.05 0.08 0.15

-- Load order for the .ds files.  Anything not listed is still loaded, after
-- these, so forgetting a file only changes startup order.
scripts = ["main.ds", "blocks.ds", "hud.ds"]
