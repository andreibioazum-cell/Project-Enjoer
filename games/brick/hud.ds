-- Кирпич: HUD.
--
-- Numbers a player must read at a glance stay shapes (the score bar, the life
-- pips); labels go through render.text in the bundled font.ttf, rasterized by
-- the TrueType text pass into the same batch on the device and the preview.
--
-- Everything here is in the same design units as the field: one call to ui()
-- scales the text, the band it sits in and the banner together, so the HUD
-- stays above the bricks on a phone instead of shrinking into 16 px of pixels.
-- No number in this file depends on a bounce or a tap — the score keeps one
-- size and one baseline, which is what keeps text from appearing to shake.

draw_hud() {
    local u = ui()
    render.font(game_font)
    render.color(1.0, 1.0, 1.0)
    render.text("Кирпич", 20.0 * u, 24.0 * u, 1.0 * u)

    -- One size, one place: only the number changes.
    render.text("Счёт: " .. game.score, 20.0 * u, 48.0 * u, 1.0 * u)
    draw_score_bar()
    draw_lives()

    if game.state == 0 then {
        render.text("Тапни или пробел, чтобы запустить мяч", 20.0 * u,
                    engine.height() - 34.0 * u, 0.85 * u)
    }
    if game.state == 2 then {
        draw_banner(1.0, 0.32, 0.32, "Проигрыш. Тапни, чтобы начать заново")
    }
    if game.state == 3 then {
        draw_banner(0.32, 0.95, 0.55, "Победа. Тапни, чтобы начать заново")
    }
    draw_life_flash()
}

draw_score_bar() {
    local u = ui()
    local total = game.blocks.count
    local filled = 0.0
    if total > 0 then {
        filled = game.score / total
    }
    if filled > 1.0 then {
        filled = 1.0
    }
    local width = engine.width() - 40.0 * u
    render.color(0.20, 0.25, 0.40)
    render.rect(20.0 * u, 62.0 * u, width, 6.0 * u)
    render.color(0.42, 0.92, 0.62)
    render.rect(20.0 * u, 62.0 * u, width * filled, 6.0 * u)
}

draw_lives() {
    local u = ui()
    for index = 0, game.lives - 1 do
        local x = engine.width() - 26.0 * u - index * 24.0 * u
        render.color(1.0, 0.45, 0.45)
        render.circle(x, 30.0 * u, 8.0 * u)
        render.color(0.05, 0.08, 0.15)
        render.circle(x, 30.0 * u, 4.0 * u)
    }
}

-- The only feedback a lost life needs: a border that lights up and fades.  It
-- is drawn in shapes, so no text is nudged out of place while it runs.
draw_life_flash() {
    if game.flash <= 0.0 then {
        return
    }
    local u = ui()
    local fade = game.flash / 0.45
    render.color(0.30 + 0.55 * fade, 0.12 + 0.12 * fade, 0.16 + 0.12 * fade)
    render.frame(3.0 * u, 3.0 * u, engine.width() - 6.0 * u, engine.height() - 6.0 * u,
                 4.0 * u * fade + 1.0)
}

draw_banner(red: float, green: float, blue: float, message: string) {
    local u = ui()
    local width = math.min(520.0 * u, engine.width() - 40.0 * u)
    local height = 92.0 * u
    local x = engine.width() / 2.0 - width / 2.0
    local y = engine.height() / 2.0 - height / 2.0
    render.color(0.04, 0.05, 0.10)
    render.rect(x, y, width, height)
    render.color(red, green, blue)
    render.frame(x, y, width, height, 3.0 * u)
    render.text(message, x + 18.0 * u, y + 28.0 * u, 1.0 * u)
}

draw_blocks(blocks: list) {
    for index = 0, blocks.count - 1 do
        brick = blocks[index]
        if brick.alive then {
            render.color(0.30 + brick.shade, 0.45 + brick.shade * 0.7, 0.95)
            render.rect(brick.x, brick.y, brick.width, brick.height)
        }
    }
}

draw_field() {
    -- Top wall, so the player sees where the ball bounces without a font.
    local u = ui()
    render.color(0.16, 0.20, 0.34)
    render.rect(0.0, 0.0, engine.width(), 12.0 * u)
    render.color(0.10, 0.13, 0.24)
    render.rect(0.0, engine.height() - 6.0 * u, engine.width(), 6.0 * u)
}
