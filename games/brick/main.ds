-- Кирпич — a real Enjoer game, split over three .ds files.
--
-- main.ds owns the state and the lifecycle callbacks, blocks.ds the layout and
-- the ball physics, hud.ds the HUD.  Compile with dimscriptc (or run it with
-- --run) after changing a number here; the device executes the AOT build.
--
-- Every number below is in design units for a 640x360 screen, multiplied by
-- ui().  A field that is 360 px tall on a preview is a strip across the middle
-- of a phone unless it scales, and so is its text.
require "blocks"
require "hud"

struct Paddle {
    x: float
    y: float
    width: float
    height: float
    speed: float
}

struct Ball {
    x: float
    y: float
    vx: float
    vy: float
    radius: float
    stuck: bool
}

struct BrickGame {
    score: int
    lives: int
    state: int -- 0 ready, 1 playing, 2 lost, 3 won
    time: float
    flash: float -- seconds left of the "you lost a life" border
    paddle: Paddle
    ball: Ball
    blocks: list
}

game = new BrickGame
target_x = 0.0
game_font = -1 -- handle from font.load, refreshed by load()

-- Pixels per design unit: the short side of the screen over the 360 px this
-- field is laid out for, clamped so a phone neither dwarfs the ball nor a
-- preview window swallows the HUD.  blocks.ds and hud.ds multiply their own
-- layout constants by the same number, so the field, the paddle and the text
-- stay one composition at any size.
ui(): float {
    return math.max(0.6, math.min(4.0, math.min(engine.width(), engine.height()) / 360.0))
}

load() {
    game.score = 0
    game.lives = 3
    game.state = 0
    game.time = 0.0
    game.flash = 0.0
    game.paddle = new Paddle
    game.ball = new Ball
    game.paddle.width = 150.0 * ui()
    game.paddle.height = 18.0 * ui()
    game.paddle.speed = 700.0 * ui()
    game.ball.radius = 9.0 * ui()
    game.blocks = build_blocks(11)
    game_font = font.load("font.ttf")
    center_paddle()
    launch_ball()
}

center_paddle() {
    game.paddle.x = engine.width() / 2.0
    game.paddle.y = engine.height() - 70.0 * ui()
    target_x = game.paddle.x
    game.ball.x = game.paddle.x
    game.ball.y = game.paddle.y - 26.0
}

resized(width: float, height: float) {
    game.paddle.y = height - 70.0 * ui()
    if game.paddle.x > width - game.paddle.width / 2.0 then {
        game.paddle.x = width - game.paddle.width / 2.0
    }
    target_x = game.paddle.x
}

update(dt: float) {
    game.time = game.time + dt
    if game.flash > 0.0 then {
        game.flash = game.flash - dt
        if game.flash < 0.0 then {
            game.flash = 0.0
        }
    }
    follow_pointer(dt)
    if game.state == 1 then {
        step_ball(game, dt)
        if game.state == 1 then {
            if game.ball.y - game.ball.radius > engine.height() then {
                lose_life()
            }
        }
    } else {
        if game.ball.stuck then {
            game.ball.x = game.paddle.x
            game.ball.y = game.paddle.y - 26.0 * ui()
        }
    }
}

follow_pointer(dt: float) {
    -- A finger or mouse pointer steers the paddle, arrows/WASD work as well.
    if input.touches() > 0 then {
        if input.touch_down(0) then {
            target_x = input.touch_x(0)
        }
    }
    if input.key("ArrowLeft") or input.key("a") then {
        target_x = target_x - game.paddle.speed * dt
    }
    if input.key("ArrowRight") or input.key("d") then {
        target_x = target_x + game.paddle.speed * dt
    }
    half = game.paddle.width / 2.0
    if target_x < half then {
        target_x = half
    }
    if target_x > engine.width() - half then {
        target_x = engine.width() - half
    }
    follow = 12.0 * dt
    if follow > 1.0 then {
        follow = 1.0
    }
    game.paddle.x = game.paddle.x + (target_x - game.paddle.x) * follow
}

lose_life() {
    game.lives = game.lives - 1
    -- The border is the feedback.  Nothing that is written on the screen moves,
    -- shrinks or slides: a HUD whose text rescales on every event is what a
    -- player reads as a shaking screen.
    game.flash = 0.45
    if game.lives <= 0 then {
        game.state = 2
        return
    }
    game.state = 0
    launch_ball()
}

touchpressed(id, touch_x, touch_y) {
    target_x = touch_x
    if game.state == 0 then {
        game.state = 1
        game.ball.stuck = false
        game.ball.vy = -330.0
    } else {
        if game.state >= 2 then {
            load() -- restart from scratch
        }
    }
}

keypressed(name: string) {
    if name == "space" then {
        if game.state == 0 then {
            game.state = 1
            game.ball.stuck = false
            game.ball.vy = -330.0
        } else {
            if game.state >= 2 then {
                load()
            }
        }
    }
}

draw() {
    render.clear(0.05, 0.08, 0.15)
    draw_field()
    draw_blocks(game.blocks)
    render.color(0.86, 0.95, 1.0)
    render.rect(game.paddle.x - game.paddle.width / 2.0, game.paddle.y, game.paddle.width,
                game.paddle.height)
    render.color(1.0, 0.78, 0.32)
    render.circle(game.ball.x, game.ball.y, game.ball.radius)
    render.ring(game.ball.x, game.ball.y, game.ball.radius + 4.0, 2.0)
    draw_hud()
}

quit() {
    delete game
}
