tr_class_level_effect(cls: float, n: float): string {
    if cls == 1 and n == 1 then
        if language == 1 then
            return "Вторая жизнь: урон -10%"
        }
        return "Second life: damage -10%"
    }
    if cls == 1 and n == 2 then
        if language == 1 then
            return "Скорость +3%"
        }
        return "Speed +3%"
    }
    if cls == 1 and n == 3 then
        if language == 1 then
            return "Атака лечит +0.1 HP"
        }
        return "Attack heals +0.1 HP"
    }
    if cls == 2 and n == 1 then
        if language == 1 then
            return "Тик яда +0.15 урона"
        }
        return "Poison tick +0.15 damage"
    }
    if cls == 2 and n == 2 then
        if language == 1 then
            return "Тик яда +0.15 урона (x2)"
        }
        return "Poison tick +0.15 damage (x2)"
    }
    if cls == 2 and n == 3 then
        if language == 1 then
            return "Яд стакается, снежинка наносит урон"
        }
        return "Poison stacks, snowflake deals damage"
    }
    if cls == 3 and n == 1 then
        if language == 1 then
            return "Турель +2 HP"
        }
        return "Turret +2 HP"
    }
    if cls == 3 and n == 2 then
        if language == 1 then
            return "Спавн турели лечит +0.5 HP"
        }
        return "Placing a turret heals +0.5 HP"
    }
    if cls == 3 and n == 3 then
        if language == 1 then
            return "Луч турели лечит +0.1 HP/сек"
        }
        return "Turret beam heals +0.1 HP/sec"
    }
    if cls == 0 and n == 1 then
        if language == 1 then
            return "Урон атаки +5%"
        }
        return "Attack damage +5%"
    }
    if cls == 0 and n == 2 then
        if language == 1 then
            return "Скорость +2%"
        }
        return "Speed +2%"
    }
    if language == 1 then
        return "Атака лечит +0.05 HP"
    }
    return "Attack heals +0.05 HP"
}

