# Enjoer Physics Playground.
#
# A RigidBody3D ball (a dynamic sphere) that you push around with WASD / the
# arrow keys and jump with Space, resting on an invisible StaticBody3D box
# (Ground) whose top face matches the visible grass Floor mesh. Two drawn
# StaticBody3D walls (WallL / WallR) also act as real colliders: the ball
# stops and bounces off them. The `roller` C script reads the engine input
# API and drives the body with impulses.
[node name="Main" type="Node"]

[node name="Sun" type="DirectionalLight3D" parent="."]
yaw = 0.5
pitch = -0.9
energy = 1.0
light_color = 1 0.96 0.88

[node name="Lamp" type="OmniLight3D" parent="."]
position = 0 3.6 0
energy = 0.9
range = 9
light_color = 1 0.8 0.55

[node name="Camera" type="Camera3D" parent="."]
position = 0 3.2 9
pitch = -0.2
fov = 66
current = true
script = "orbit"

# Invisible collision floor; its top face sits at y=0 (the Floor's height).
# It carries no mesh, so it is never drawn.
[node name="Ground" type="StaticBody3D" parent="."]
shape = box
size = 60
position = 0 -30 0

# Visible grass floor (decorative; the ball's support is Ground above it).
[node name="Floor" type="MeshInstance3D" parent="."]
mesh = plane
material = grass
size = 40

# Two visible colliders to roll the ball against.
[node name="WallL" type="StaticBody3D" parent="."]
mesh = cube
material = log
size = 2
position = -6 1 -1

[node name="WallR" type="StaticBody3D" parent="."]
mesh = cube
material = log
size = 2
position = 6 1 -1

# The controllable ball: RigidBody3D is a dynamic sphere (radius = size/2),
# so its physics body always coincides with the orange ball you see.
[node name="Ball" type="RigidBody3D" parent="."]
mesh = sphere
color = 0.95 0.62 0.18
shape = sphere
size = 2
mass = 1
restitution = 0.3
position = 0 4 0
script = "roller"
